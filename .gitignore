# =============================================================================
# Resolvo – root .gitignore
# Frontend (Angular) heeft daarnaast nog zijn eigen frontend/.gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# .NET / C# (backend: API + toekomstige class libraries)
# -----------------------------------------------------------------------------
# Build output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Ll]og/
[Ll]ogs/
artifacts/
publish/
*.publish.xml
PublishProfiles/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*.rsuser
*.vspscc
*.vssscc

# Rider / ReSharper
.idea/
*.sln.iml
_ReSharper*/
*.DotSettings.user

# Test results & coverage
TestResults/
[Tt]est[Rr]esult*/
coverage/
*.coverage
*.coveragexml
*.trx
coverage*.json
coverage*.xml
coverage*.info

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
project.lock.json
project.fragment.lock.json

# Entity Framework
*.edmx.diagram
*.edmx.sql

# Lokale secrets / overrides (appsettings.json en appsettings.Development.json
# blijven wél getrackt)
appsettings.*.local.json
appsettings.Local.json
secrets.json
*.pfx
*.p12

# Hot reload / tooling
.dotnet/
*.swp
*.tmp
~$*
BenchmarkDotNet.Artifacts/

# -----------------------------------------------------------------------------
# Node / Angular (frontend)
# -----------------------------------------------------------------------------
node_modules/
dist/
out-tsc/
.angular/
.sass-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# Editors
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# -----------------------------------------------------------------------------
# Environment & OS
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
Desktop.ini
*.log
